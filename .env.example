# LexiMem — Environment Configuration
# Copy this file to .env and configure your secrets

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas or local MongoDB; auto-in-memory fallback enabled if offline)
MONGODB_URI=mongodb://localhost:27017/leximem

# JWT Authentication
JWT_SECRET=leximem_enterprise_jwt_secure_secret_key_2026
JWT_EXPIRES_IN=7d

# Groq LLM Inference API
# Get your API key at: https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.1
GROQ_MAX_TOKENS=4096

# Hindsight Persistent Precedent Memory Engine
# Official docs: https://hindsight.vectorize.io/
# Cloud Base URL: https://api.hindsight.vectorize.io (or http://localhost:8888 for self-hosted Docker)
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=leximem-precedents

# Python Document Processor Microservice (Optional: PyMuPDF / python-docx service)
DOC_PROCESSOR_URL=http://localhost:8000

# File Upload Configuration
MAX_FILE_SIZE_MB=25
UPLOAD_DIR=uploads
